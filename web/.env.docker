# Local docker build template. Fill FIREBASE_* with YOUR project's web config
# in a copy named .env (ignored by git), never in this file.
API_BASE_URL=http://localhost:8000

APP_URL=http://localhost:3000
APP_NAME=httpSMS
APP_GITHUB_URL=https://github.com/Ciudad-Valles-Open-Source/httpsms
APP_DOWNLOAD_URL=https://github.com/Ciudad-Valles-Open-Source/httpsms/releases/latest/download/HttpSms.apk
APP_ENV=production

# Firebase credentials
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Cloudflare Turnstile site key for captcha on the search messages page
# Get your site key at https://developers.cloudflare.com/turnstile/get-started/
CLOUDFLARE_TURNSTILE_SITE_KEY=
