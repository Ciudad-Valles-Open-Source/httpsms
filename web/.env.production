# Production build template for this fork. Fill in your own values.
# (Not used by docker-compose / Coolify, which pass build args instead.)
API_BASE_URL=https://api.your-domain.com
APP_URL=https://your-domain.com
APP_NAME=httpSMS
APP_GITHUB_URL=https://github.com/Ciudad-Valles-Open-Source/httpsms
APP_DOWNLOAD_URL=https://github.com/Ciudad-Valles-Open-Source/httpsms/releases/latest/download/HttpSms.apk
APP_ENV=production

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

CLOUDFLARE_TURNSTILE_SITE_KEY=

SOKETI_KEY=
SOKETI_CLUSTER=mt1
USE_SOKETI=true
