# =============================================================================
# httpSMS – Environment Variables Template
# =============================================================================
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# For Coolify deployments, set these variables in Coolify's UI instead.
# =============================================================================

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=httpsms
POSTGRES_USER=httpsms
POSTGRES_PASSWORD=changeme

# ─── Firebase (REQUIRED) ─────────────────────────────────────────────────────
# Service account JSON (single-line, used by the API)
FIREBASE_CREDENTIALS=

# Firebase project ID
GCP_PROJECT_ID=

# Firebase Web SDK config (used by the Web UI at build time)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# ─── SMTP Email (REQUIRED for email notifications) ──────────────────────────
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM_NAME=httpSMS
SMTP_FROM_EMAIL=noreply@httpsms.local

# ─── Cloudflare Turnstile ────────────────────────────────────────────────────
# Required for the /v1/messages/search captcha
CLOUDFLARE_TURNSTILE_SECRET_KEY=
CLOUDFLARE_TURNSTILE_SITE_KEY=

# ─── Event Queue System User ─────────────────────────────────────────────────
# On first boot (empty DB), the API auto-creates the system user from these
# values. If left empty, they are auto-generated and printed to stdout.
EVENTS_QUEUE_USER_API_KEY=
EVENTS_QUEUE_USER_ID=
EVENTS_QUEUE_USER_EMAIL=system@httpsms.local

# ─── Application URLs ────────────────────────────────────────────────────────
# For local development, leave defaults. For production, set your domains.
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
SWAGGER_HOST=localhost:8000

# ─── App Identity ────────────────────────────────────────────────────────────
APP_NAME=httpSMS
APP_GITHUB_URL=https://github.com/NdoleStudio/httpsms
APP_DOCUMENTATION_URL=https://docs.httpsms.com
APP_DOWNLOAD_URL=https://github.com/NdoleStudio/httpsms/releases/latest/download/HttpSms.apk
APP_ENV=production
ENV=local

# ─── Optional: Exposed Ports (local dev only, not used in Coolify) ───────────
# APP_PORT=8000
# WEB_PORT=3000
# POSTGRES_PORT=5432
# REDIS_PORT=6379

# ─── Optional: WebSockets (Real-time UI updates) ───────────────────────────
# You can use the included Soketi container
SOKETI_APP_ID=app-id
SOKETI_KEY=app-key
SOKETI_SECRET=app-secret
SOKETI_CLUSTER=mt1
USE_SOKETI=true

# ─── Optional: Axiom Observability ───────────────────────────────────────────
AXIOM_TOKEN=
AXIOM_DATASET_EVENTS=
AXIOM_DATASET_METRICS=

# ─── Optional: Google Cloud Storage (MMS attachments) ────────────────────────
GCS_BUCKET_NAME=

# ─── Optional: Feature flags ─────────────────────────────────────────────────
ENTITLEMENT_ENABLED=false
ENABLE_BILLING=false
USE_HTTP_LOGGER=true

# ─── Event Queue Config ──────────────────────────────────────────────────────
EVENTS_QUEUE_TYPE=emulator
EVENTS_QUEUE_NAME=events-local
EVENTS_QUEUE_ENDPOINT=http://localhost:8000/v1/events
